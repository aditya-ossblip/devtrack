{
  "name": "devtrack-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "backend\\.venv\\Scripts\\python.exe backend\\run.py",
    "test": "backend\\.venv\\Scripts\\python.exe -m pytest backend",
    "seed": "backend\\.venv\\Scripts\\python.exe backend\\seed.py",
    "db:init": "cd backend && .venv\\Scripts\\flask.exe --app run:app db init",
    "db:migrate": "cd backend && .venv\\Scripts\\flask.exe --app run:app db migrate",
    "db:upgrade": "cd backend && .venv\\Scripts\\flask.exe --app run:app db upgrade",
    "db:downgrade": "cd backend && .venv\\Scripts\\flask.exe --app run:app db downgrade",
    "db:history": "cd backend && .venv\\Scripts\\flask.exe --app run:app db history",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
