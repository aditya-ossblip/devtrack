# Copy to backend/.env and edit. Never commit the real .env.

# Where this copy runs: development (your PC or Mac) or production (the live
# server). Production turns password sign-in and reset links off and refuses
# to start without a real SECRET_KEY, a Postgres DATABASE_URL and a Google
# client ID.
DEVTRACK_ENV=development

# Signs the JWTs. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-anyone-else-runs-this

# Postgres. A URL from a host (Render, Neon, Supabase, Railway) can be pasted
# as it is, postgres:// or postgresql://. Locally, see SETUP.md:
# DATABASE_URL=postgresql://devtrack:password@localhost:5432/devtrack
# Left blank, the app falls back to a SQLite file (instance/devtrack.db) so a
# fresh clone starts before Postgres is installed. Do not launch on that.
DATABASE_URL=

# Only for `npm run test:postgres`. A SEPARATE database: every test empties it.
# TEST_DATABASE_URL=postgresql://devtrack:password@localhost:5432/devtrack_test

# How long a login lasts, in seconds. 86400 = 24h.
JWT_EXPIRES_SECONDS=86400

# Origins allowed to call the API. The Vite dev proxy makes this same-origin,
# so you only need it if you point the frontend straight at :5001.
CORS_ORIGINS=http://localhost:5173

# Largest file that can be attached to an issue, in bytes. 8MB here; if this
# line is removed, config.py falls back to 25MB.
MAX_UPLOAD_BYTES=8388608

# How long a password-reset link stays valid, in seconds. Default 1 hour.
RESET_TOKEN_TTL_SECONDS=3600

# With no mail server, the reset link has to reach the user somehow. Set to 1
# and the API returns the link directly so the flow is usable in development.
# Ignored in production, where it is always off.
RESET_RETURN_TOKEN=1

# Email-and-password accounts. Default: on in development (for the demo
# account), off in production (Google only). Uncomment to force either way.
# PASSWORD_SIGN_IN=0

# --- Google sign-in ---------------------------------------------------------
# Required in production, where it is the only way in. Leave blank locally and
# the Google button does not appear; the demo password account still works.
#
# To turn it on: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application. Add
# http://localhost:5173 (and later your live address) under "Authorized
# JavaScript origins". Paste the
# Client ID below. There is no client secret to add — this flow does not use
# one, so nothing secret belongs in this file.
GOOGLE_CLIENT_ID=
